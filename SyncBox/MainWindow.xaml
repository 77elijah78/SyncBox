<Window x:Class="SyncBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncBox"
        Title="SyncBox" Height="860" Width="600" MinHeight="540" MinWidth="480"
        Background="{StaticResource SyncBgBrush}"
        Foreground="{StaticResource SyncTextBrush}"
        FontFamily="{StaticResource SyncFont}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Icon="Assets/SyncBox.ico">

    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:ConnectionColorConverter x:Key="ConnectionColor" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SyncSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="{StaticResource SyncBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0"
                        Background="{StaticResource SyncAccentGradient}">
                    <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="3" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SYNCBOX" FontSize="21" FontWeight="Black" />
                    <TextBlock Text="Screen-to-LED synchronization" FontSize="11"
                               Foreground="{StaticResource SyncFaintBrush}" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="12,7"
                    MaxWidth="260"
                    Background="{StaticResource SyncSurfaceBrush}"
                    BorderBrush="{StaticResource SyncBorderBrush}" BorderThickness="1"
                    ToolTip="{Binding ConnectionSummary}">
                <TextBlock Text="{Binding ConnectionSummary}" FontSize="11"
                           Foreground="{StaticResource SyncMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Margin="16,0"
                    Style="{StaticResource SyncTabControl}">
            <TabItem Header="DASHBOARD" Style="{StaticResource SyncTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CAPTURE ENGINE" Style="{StaticResource ProLabel}" />
                                <UniformGrid Columns="2" Height="40">
                                    <RadioButton Content="GPU / DXGI" Margin="0,0,4,0"
                                                 Style="{StaticResource SegmentedToggle}"
                                                 IsChecked="{Binding UseGpu}" />
                                    <RadioButton Content="CPU / GDI" Margin="4,0,0,0"
                                                 Style="{StaticResource SegmentedToggle}"
                                                 IsChecked="{Binding UseGpu, Converter={StaticResource InverseBool}}" />
                                </UniformGrid>
                                <TextBlock Text="{Binding CaptureInfo}" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{StaticResource SyncFaintBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding CaptureInfo, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="INTERFACE" Style="{StaticResource ProLabel}" />
                                <UniformGrid Columns="2" Height="40" Margin="0,0,0,12">
                                    <RadioButton Content="USB SERIAL" Margin="0,0,4,0"
                                                 Style="{StaticResource SegmentedToggle}"
                                                 IsChecked="{Binding UseWifi, Converter={StaticResource InverseBool}}" />
                                    <RadioButton Content="WI-FI / UDP" Margin="4,0,0,0"
                                                 Style="{StaticResource SegmentedToggle}"
                                                 IsChecked="{Binding UseWifi}" />
                                </UniformGrid>

                                <StackPanel Visibility="{Binding UseWifi, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                    <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                                      SelectedItem="{Binding ComPort}"
                                                      ToolTip="Serial ports reported by Windows." />
                                            <TextBlock Text="No port selected" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" FontSize="11"
                                                       Foreground="{StaticResource SyncFaintBrush}"
                                                       Visibility="{Binding ComPort, Converter={StaticResource StringToVisibility}, ConverterParameter=Inverse}" />
                                        </Grid>
                                        <Button x:Name="DetectDeviceButton" Grid.Column="1" Content="Detect" Height="34" MinHeight="34"
                                                MinWidth="84" Margin="8,0,0,0"
                                                Command="{Binding DetectDeviceCommand}"
                                                ToolTip="Probe the serial ports for a Sync Box controller." />
                                        <Button Grid.Column="2" Content="Refresh" Height="34" MinHeight="34" MinWidth="84"
                                                Margin="8,0,0,0" Command="{Binding RefreshSerialPortsCommand}"
                                                ToolTip="Re-read the serial ports reported by Windows." />
                                    </Grid>

                                    <CheckBox Content="Pick the port automatically on connect"
                                              IsChecked="{Binding AutoDetectDevice}" Margin="0,14,0,0" />

                                    <Border Background="{StaticResource SyncFieldBrush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,10,0,0"
                                            BorderBrush="{StaticResource SyncBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceVersionText}" FontSize="11"
                                                       Foreground="{StaticResource SyncMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Detection sends AF 05 D1 and waits for the controller to answer with Sync Box V1.0."
                                                       FontSize="10" Foreground="{StaticResource SyncFaintBrush}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="BAUD RATE" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                    <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=N0}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Visibility="{Binding UseWifi, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="DEVICES ON YOUR NETWORK" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <ComboBox ItemsSource="{Binding LanDevices}"
                                                      SelectedItem="{Binding SelectedLanDevice}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="Devices that answered on the router your PC is connected to." />
                                            <TextBlock Text="No devices found yet" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       FontSize="11" Foreground="{StaticResource SyncFaintBrush}"
                                                       Visibility="{Binding HasLanDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                        </Grid>
                                        <Button x:Name="FindNetworkDevicesButton" Grid.Column="1" Content="Scan" Height="34" MinHeight="34"
                                                MinWidth="84" Margin="8,0,0,0"
                                                Command="{Binding FindNetworkDevicesCommand}"
                                                ToolTip="List the devices connected to your router and look for the SyncBox controller." />
                                    </Grid>

                                    <CheckBox Content="Find the controller on my network automatically on connect"
                                              IsChecked="{Binding AutoFindOnNetwork}" Margin="0,14,0,0" />

                                    <Border Background="{StaticResource SyncFieldBrush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,10,0,0"
                                            BorderBrush="{StaticResource SyncBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NetworkStatusText}" FontSize="11"
                                                       Foreground="{StaticResource SyncMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Scans the router your PC is connected to, not the Wi-Fi networks in range, then picks the device whose name or handshake identifies it as a SyncBox."
                                                       FontSize="10" Foreground="{StaticResource SyncFaintBrush}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="CONTROLLER IP" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                        </StackPanel>
                                        <StackPanel Margin="5,0,0,0">
                                            <TextBlock Text="UDP PORT" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="UDP is connectionless: SyncBox cannot confirm the controller is listening."
                                               FontSize="11" Foreground="{StaticResource SyncFaintBrush}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <Border Height="1" Background="{StaticResource SyncBorderBrush}" Margin="0,14,0,0" />

                                    <CheckBox Content="Use the controller's own Wi-Fi access point instead"
                                              IsChecked="{Binding UseControllerAp}" Margin="0,12,0,0" />

                                    <StackPanel Visibility="{Binding UseControllerAp, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="WI-FI NETWORK" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding AvailableWifiNetworks}"
                                                          SelectedItem="{Binding SelectedWifiNetwork}"
                                                          DisplayMemberPath="DisplayName"
                                                          ToolTip="SyncBox networks found by the last scan." />
                                                <TextBlock Text="No SyncBox Wi-Fi found yet" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                                           FontSize="11" Foreground="{StaticResource SyncFaintBrush}"
                                                           Visibility="{Binding HasWifiNetworks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                            </Grid>
                                            <Button x:Name="ScanWifiButton" Grid.Column="1" Content="Scan" Height="34" MinHeight="34"
                                                    MinWidth="84" Margin="8,0,0,0"
                                                    Command="{Binding ScanWifiCommand}"
                                                    ToolTip="Look for Wi-Fi networks named like SyncBox." />
                                        </Grid>

                                        <CheckBox Content="Join it automatically on connect"
                                                  IsChecked="{Binding AutoDetectWifi}" Margin="0,14,0,0" />

                                        <Border Background="{StaticResource SyncFieldBrush}" CornerRadius="8"
                                                Padding="10,8" Margin="0,10,0,0"
                                                BorderBrush="{StaticResource SyncBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding WifiStatusText}" FontSize="11"
                                                           Foreground="{StaticResource SyncMutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="Only for an access point created by the controller. The strongest matching network is joined and its gateway becomes the controller IP."
                                                           FontSize="10" Foreground="{StaticResource SyncFaintBrush}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="WIFI PASSWORD (OPTIONAL)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <PasswordBox x:Name="WifiPasswordBox" MaxLength="128"
                                                     PasswordChanged="OnWifiPasswordChanged"
                                                     ToolTip="Only needed when that access point is secured. Saved in settings.json on this PC." />
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="{Binding ConnectButtonText}" Height="46" Margin="0,16,0,0"
                                        Command="{Binding ToggleConnectionCommand}"
                                        Background="{StaticResource SyncAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TARGET" Style="{StaticResource ProLabel}" />
                                <UniformGrid Columns="2" Height="40" Margin="0,0,0,12">
                                    <RadioButton Content="Full desktop" Margin="0,0,4,0"
                                                 Style="{StaticResource SegmentedToggle}"
                                                 IsChecked="{Binding CaptureWholeDesktop}" />
                                    <RadioButton Content="Single app" Margin="4,0,0,0"
                                                 Style="{StaticResource SegmentedToggle}"
                                                 IsChecked="{Binding CaptureWholeDesktop, Converter={StaticResource InverseBool}}" />
                                </UniformGrid>

                                <Grid Visibility="{Binding CaptureWholeDesktop, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="WINDOW" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ActiveWindows}"
                                                  SelectedItem="{Binding SelectedWindow}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                                                   Foreground="{StaticResource SyncFaintBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Margin="10,0,0,0"
                                            VerticalAlignment="Bottom" Height="34" MinHeight="34"
                                            Command="{Binding RefreshWindowsCommand}" />
                                </Grid>

                                <CheckBox Content="Cinematic mode (ignore letterbox and pillarbox bars)"
                                          IsChecked="{Binding IsCinematicMode}" Margin="0,14,0,0" />

                                <TextBlock Text="BAR DETECTION THRESHOLD" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="0.4" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            Value="{Binding BarThreshold}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding BarThreshold, StringFormat=F2}"
                                               Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TRANSPORT" Style="{StaticResource ProLabel}" />
                                <TextBlock Text="FRAME RATE LIMIT" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="240" TickFrequency="15" IsSnapToTickEnabled="True"
                                            Value="{Binding TargetFps}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="86" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding TargetFpsText}" Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>

                                <CheckBox Content="Wait for a device ACK after every frame"
                                          IsChecked="{Binding RequireAck}" Margin="0,8,0,0" />
                                <TextBlock Text="Leave this off unless the controller firmware sends 0xAA 0x55 ACK frames. Each ACK is waited on for at most 12 ms."
                                           FontSize="11" Foreground="{StaticResource SyncFaintBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,4,0,12">
                            <Button Content="START" Height="58" Margin="0,0,5,0"
                                    Background="{StaticResource SyncSuccessBrush}" Foreground="#04240F"
                                    FontSize="15" FontWeight="Black" Command="{Binding StartCommand}" />
                            <Button Content="STOP" Height="58" Margin="5,0,0,0"
                                    Background="{StaticResource SyncDangerBrush}"
                                    FontSize="15" Command="{Binding StopCommand}" />
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="TUNING" Style="{StaticResource SyncTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="COLOUR PIPELINE" Style="{StaticResource ProLabel}" />
                                <TextBlock Text="Colours are decoded from sRGB to linear, adjusted, then re-encoded. Gamma therefore behaves like a display gamma, not a second sRGB curve."
                                           FontSize="11" Foreground="{StaticResource SyncFaintBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,14" />

                                <TextBlock Text="BRIGHTNESS" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            Value="{Binding GlobalBrightness}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding GlobalBrightness, StringFormat=F2}"
                                               Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>

                                <TextBlock Text="GAMMA" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0.4" Maximum="2.4" TickFrequency="0.05"
                                            Value="{Binding Gamma}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Gamma, StringFormat=F2}"
                                               Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>

                                <TextBlock Text="SATURATION" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="2" TickFrequency="0.05"
                                            Value="{Binding Saturation}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Saturation, StringFormat=F2}"
                                               Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RESPONSE" Style="{StaticResource ProLabel}" />
                                <TextBlock Text="SMOOTHING" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding Smoothing}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Smoothing, StringFormat=F2}"
                                               Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>

                                <TextBlock Text="SAMPLE AVERAGE (PIXELS PER LED)" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding AverageSize}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding AverageSize}"
                                               Foreground="{StaticResource SyncMutedBrush}" />
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,16,0,0">
                                    <Button Content="Reset tuning" Margin="0,0,5,0" Command="{Binding ResetTuningCommand}" />
                                    <Button Content="Clear smoothing" Margin="5,0,0,0" Command="{Binding ResetSmoothingCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SETTINGS" Style="{StaticResource ProLabel}" />
                                <TextBlock Text="{Binding SettingsPath}" FontSize="11" Foreground="{StaticResource SyncFaintBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="Save settings now" Command="{Binding PersistSettingsCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="LEDS" Style="{StaticResource SyncTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LAYOUT" Style="{StaticResource ProLabel}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="HORIZONTAL PER EDGE" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding HorizontalLedCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="VERTICAL PER EDGE" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding VerticalLedCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,12,0,0" Foreground="{StaticResource SyncMutedBrush}">
                                    <Run Text="{Binding TotalLedCount, Mode=OneWay}" />
                                    <Run Text=" LEDs in the perimeter ring - " />
                                    <Run Text="{Binding FrameByteSize, Mode=OneWay}" />
                                    <Run Text=" bytes per frame." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LIVE OUTPUT PREVIEW" Style="{StaticResource ProLabel}" />
                                <ItemsControl ItemsSource="{Binding LedPreviewItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="18" Height="18" CornerRadius="4" Margin="2"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="{StaticResource SyncBorderBrush}" BorderThickness="1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SyncSurfaceBrush}" BorderBrush="{StaticResource SyncBorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding IsConnected, Converter={StaticResource ConnectionColor}}" />
                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="{StaticResource SyncMutedBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding MessageText}" ToolTip="{Binding MessageText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SyncFaintBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SyncDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Fps}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource SyncSuccessBrush}" />
                    <TextBlock Text="FPS" FontSize="10" Foreground="{StaticResource SyncFaintBrush}"
                               VerticalAlignment="Bottom" Margin="3,0,0,3" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>